# ==========================================
# Groq API (Primary AI & Whisper STT)
# ==========================================
# Get a free API key from Groq Console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Recommended high-speed Llama models:
# - llama-3.3-70b-versatile (Default: High accuracy, low latency)
# - llama-3.1-8b-instant (Fastest instant inference)
GROQ_MODEL=llama-3.3-70b-versatile

# Speech-to-Text (Voice Input) Model:
# - whisper-large-v3 (Default: Highest multilingual accuracy)
# - whisper-large-v3-turbo (Alternative: Ultra-fast transcription)
STT_MODEL=whisper-large-v3

# ==========================================
# Google Gemini API (Fallback AI & Speech TTS)
# ==========================================
# Get a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended free-tier multimodal models:
# - gemini-2.0-flash (Default: Fast text and native audio generation)
# - gemini-1.5-flash (Alternative fallback)
GEMINI_MODEL=gemini-2.0-flash

# Text-to-Speech (Voice Output) Model:
# - gemini-2.0-flash (Default: AI Studio multimodal audio output)
TTS_MODEL=gemini-2.0-flash

# ==========================================
# Provider Selection & Dynamic Language Routing
# ==========================================
# Global default primary provider: "groq" (default) or "gemini"
AI_PRIMARY=groq

# Optional per-language routing override (JSON format):
# Allows testing quality per language without code changes.
# Default: English and Hindi route to Groq; Marathi, Bengali, Tamil, Telugu route to Gemini.
AI_LANGUAGE_ROUTING={"en":"groq","hi":"groq","mr":"gemini","bn":"gemini","ta":"gemini","te":"gemini"}

# ==========================================
# OpenAQ API (Government Air Quality Ground Data)
# ==========================================
# Get a free API key from OpenAQ: https://explore.openaq.org/register
# Used server-side only to fetch nearby reference monitor PM2.5 within 25 km.
# If omitted or unavailable, Clearhale smoothly falls back to Open-Meteo forecast estimates.
OPENAQ_API_KEY=your_openaq_api_key_here

# ==========================================
# Developer Testing Toggle
# ==========================================
# Set to "true" to deliberately force the primary provider to fail,
# verifying the 5-second switchover and backup streaming path.
# DEBUG_FORCE_FALLBACK=true

# ==========================================
# Firebase (Optional Google Login & Cloud Profile)
# ==========================================
# Free plan (Spark) with Firebase Auth (Google Provider) and Cloud Firestore.
# If omitted, Clearhale operates 100% locally on the device (localStorage).
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id


# ==========================================
# Theme Neutral Experiment Toggle
# ==========================================
NEXT_PUBLIC_THEME_EXPERIMENT=true
